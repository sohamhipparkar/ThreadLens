# ThreadLens configuration
# 1) Copy this file to .env (already done for you) and fill in your key.
# 2) Run:  node setup.js     (or: python setup.py)
#    This writes extension/config.js, which the extension reads.
# 3) Reload the extension in chrome://extensions.

# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id (e.g. gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Privacy (true/false): mask emails/phones/IDs/secrets, and optionally participant names
REDACT_CONTACT_INFO=true
PSEUDONYMIZE_NAMES=false

# Faithfulness: run a second Gemini pass that fact-checks each claim against its cited emails
VERIFY_WITH_LLM=true

# Long-thread handling (approximate tokens). Threads above the single-pass limit are
# split at email boundaries and processed map-reduce. Low defaults so the long sample
# shows chunking in a demo; use e.g. 8000 / 3000 for everyday use.
SINGLE_PASS_TOKEN_LIMIT=1500
CHUNK_TOKENS=900
