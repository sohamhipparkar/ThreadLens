{
  "manifest_version": 3,
  "name": "ThreadLens — Email Thread Summarizer & Action Tracker",
  "short_name": "ThreadLens",
  "version": "1.0.0",
  "description": "Summarise long email threads, extract action items with owners, verify every claim against the source, and chat with the thread. Powered by Gemini.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open ThreadLens", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Open ThreadLens" }
  }
}
